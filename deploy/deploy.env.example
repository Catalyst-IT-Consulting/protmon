# Copy to /etc/protmon/deploy.env on the Pi. Host-specific, not in git.

# Branch the Pi tracks. "release" is fast-forwarded from main by CI only when
# checks pass, so a broken main cannot reach the wall. Set to "main" to deploy
# every push directly, with preflight and health check as the only gates.
DEPLOY_REF=release
DEPLOY_REMOTE=origin

APP_DIR=/opt/protmon
STATE_DIR=/var/lib/protmon
LOG_DIR=/var/log/protmon

# Endpoints the alert server must expose on localhost. See the deploy contract
# in docs/DEPLOYMENT.md. Blank HEALTH_URL skips the health gate, blank
# STATE_URL skips the live-alert gate. Do not leave them blank in production.
HEALTH_URL=http://127.0.0.1:8080/healthz
STATE_URL=http://127.0.0.1:8080/api/state
HEALTH_TIMEOUT=30

# Log a louder event once a deploy has been waiting this long on a live alert.
DEFER_WARN_AFTER=1800

# Units the deployer restarts. Absent units are skipped with a log line, which
# is what lets the deployer run before the app itself exists.
SERVER_UNITS=protmon-server.service
GO2RTC_UNITS=protmon-go2rtc.service
KIOSK_UNITS=protmon-kiosk.service
