[Unit]
Description=Protmon: alert server
Documentation=https://github.com/Catalyst-IT-Consulting/protmon
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/protmon/secrets.env
WorkingDirectory=/opt/protmon/server
ExecStart=/var/lib/protmon/venv/bin/python -m protmon
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# Cheap hardening; the dirs are created by the deployer, so just allow writes.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/protmon /var/lib/protmon
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
