[Unit]
Description=Protmon: inbound firewall
Documentation=https://github.com/Catalyst-IT-Consulting/protmon
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/protmon-firewall

[Install]
WantedBy=multi-user.target
